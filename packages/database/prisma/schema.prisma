generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String
  firstName    String
  lastName     String
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  userCentres  UserCentre[]

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  
  uploadedMaterials StudyMaterial[]
  assignmentsUploaded Assignment[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique // e.g., 'students.create'
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Centre {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  address     String?
  contactNo   String?
  email       String?
  status      CentreStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userCentres UserCentre[]
  batches     Batch[]
  liveClasses LiveClass[]
  exams       Exam[]

  @@map("centres")
}

enum CentreStatus {
  ACTIVE
  INACTIVE
}

model UserCentre {
  userId   String
  centreId String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  centre   Centre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@id([userId, centreId])
  @@map("user_centres")
}

// -----------------------------------------------------------------------------
// CORE ACADEMIC HIERARCHY
// -----------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "2025-26"
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches   Batch[]
  exams     Exam[]
  materials StudyMaterial[]

  @@map("academic_years")
}

model Board {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "CBSE", "State"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches     Batch[]
  syllabi     Syllabus[]
  liveClasses LiveClass[]
  exams       Exam[]

  @@map("boards")
}

model Standard {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "Class 11", "Class 12"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches     Batch[]
  syllabi     Syllabus[]
  liveClasses LiveClass[]
  exams       Exam[]

  @@map("standards")
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "Physics", "Chemistry"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syllabi             Syllabus[]
  teacherAssignments  TeacherAssignment[]
  studentAssignments  Assignment[]
  exams               Exam[]

  @@map("subjects")
}

// -----------------------------------------------------------------------------
// CURRICULUM HIERARCHY
// -----------------------------------------------------------------------------

model Syllabus {
  id         String   @id @default(uuid())
  boardId    String
  standardId String
  subjectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  chapters   Chapter[]
  materials  StudyMaterial[]

  @@unique([boardId, standardId, subjectId])
  @@map("syllabi")
}

model Chapter {
  id         String   @id @default(uuid())
  name       String
  syllabusId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  topics     Topic[]

  exams      Exam[]
  materials  StudyMaterial[]
  batchProgress BatchChapterProgress[]

  @@map("chapters")
}

model Topic {
  id        String   @id @default(uuid())
  name      String
  chapterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  exams     Exam[]
  materials StudyMaterial[]
  batchProgress BatchTopicProgress[]

  @@map("topics")
}

// -----------------------------------------------------------------------------
// ORGANIZATIONAL HIERARCHY (Batches)
// -----------------------------------------------------------------------------

model Batch {
  id             String   @id @default(uuid())
  name           String   // e.g., "Division A", "Morning Batch"
  academicYearId String
  boardId        String
  standardId     String
  centreId       String
  track          TrackType @default(BOTH)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  board          Board        @relation(fields: [boardId], references: [id])
  standard       Standard     @relation(fields: [standardId], references: [id])
  centre         Centre       @relation(fields: [centreId], references: [id])

  enrollments    Enrollment[]
  assignments    TeacherAssignment[]
  exams          Exam[]
  homeworks      Assignment[]
  chapterProgress BatchChapterProgress[]
  topicProgress   BatchTopicProgress[]

  @@map("batches")
}

// -----------------------------------------------------------------------------
// STUDENTS & ENROLLMENT
// -----------------------------------------------------------------------------

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  admissionNo String   @unique
  parentName  String?
  parentEmail String?
  parentPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  feeRecords  FeeRecord[]
  submissions AssignmentSubmission[]

  @@map("student_profiles")
}

model Enrollment {
  id               String   @id @default(uuid())
  studentProfileId String
  batchId          String
  track            TrackType @default(BOTH)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  batch            Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, batchId])
  @@map("enrollments")
}

// -----------------------------------------------------------------------------
// TEACHERS & ASSIGNMENTS
// -----------------------------------------------------------------------------

model TeacherProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  qualification  String?
  experience     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments    TeacherAssignment[]

  @@map("teacher_profiles")
}

model TeacherAssignment {
  id               String   @id @default(uuid())
  teacherProfileId String
  batchId          String
  subjectId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  batch            Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, batchId, subjectId])
  @@map("teacher_assignments")
}

// -----------------------------------------------------------------------------
// ACADEMIC CONTENT
// -----------------------------------------------------------------------------

model Exam {
  id             String     @id @default(uuid())
  title          String
  type           ExamType   @default(QUESTION_BANK)
  academicYearId String
  batchId        String?    // Made optional to support general class/board exams
  subjectId      String
  chapterId      String?
  topicId        String?
  
  boardId        String?
  standardId     String?
  centreId       String?
  
  targetTrack    TrackType  @default(BOTH)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  batch          Batch?       @relation(fields: [batchId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  chapter        Chapter?     @relation(fields: [chapterId], references: [id])
  topic          Topic?       @relation(fields: [topicId], references: [id])
  
  board          Board?       @relation(fields: [boardId], references: [id])
  standard       Standard?    @relation(fields: [standardId], references: [id])
  centre         Centre?      @relation(fields: [centreId], references: [id])

  mcqQuestions   McqQuestion[]

  @@map("exams")
}

enum ExamType {
  QUESTION_BANK
  MOCK_TEST
  MCQ_EXAM
}

model StudyMaterial {
  id             String   @id @default(uuid())
  title          String
  type           MaterialType // e.g., PDF, VIDEO, LINK
  url            String?
  academicYearId String
  syllabusId     String
  chapterId      String?
  topicId        String?
  uploaderId     String?
  
  targetTrack    TrackType  @default(BOTH)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  syllabus       Syllabus     @relation(fields: [syllabusId], references: [id])
  chapter        Chapter?     @relation(fields: [chapterId], references: [id])
  topic          Topic?       @relation(fields: [topicId], references: [id])
  uploader       User?        @relation(fields: [uploaderId], references: [id])

  @@map("study_materials")
}

enum MaterialType {
  PDF
  VIDEO
  LINK
  DOCUMENT
}


model McqQuestion {
  id            String   @id @default(uuid())
  questionText  String
  imageUrl      String?
  options       Json
  correctOption String
  explanation   String?
  marks         Float    @default(4)
  negativeMarks Float    @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  @@map("mcq_questions")
}

// -----------------------------------------------------------------------------
// LIVE CLASSES
// -----------------------------------------------------------------------------

model LiveClass {
  id          String          @id @default(uuid())
  title       String
  subject     String
  teacherName String
  status      LiveClassStatus @default(SCHEDULED)
  scheduledAt DateTime
  duration    Int             // in minutes
  roomId      String          @unique @default(uuid())

  boardId     String?
  standardId  String?
  centreId    String?

  board       Board?    @relation(fields: [boardId],    references: [id])
  standard    Standard? @relation(fields: [standardId], references: [id])
  centre      Centre?   @relation(fields: [centreId],   references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("live_classes")
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
}

model FeeRecord {
  id          String    @id @default(uuid())
  receiptNo   String    @unique
  studentId   String
  amount      Float
  date        DateTime  @default(now())
  status      FeeStatus @default(PENDING)
  paymentMode String?
  feeHead     String?

  student     StudentProfile @relation(fields: [studentId], references: [id])
  
  targetTrack TrackType @default(BOTH)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("fee_records")
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
}

// -----------------------------------------------------------------------------
// ASSIGNMENTS
// -----------------------------------------------------------------------------

model Assignment {
  id             String   @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime?
  attachments    Json?    // Optional JSON containing array of { url: string, filename: string }
  
  batchId        String?
  subjectId      String?
  uploaderId     String
  targetTrack    TrackType @default(BOTH)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batch          Batch?   @relation(fields: [batchId], references: [id])
  subject        Subject? @relation(fields: [subjectId], references: [id])
  uploader       User     @relation(fields: [uploaderId], references: [id])
  
  submissions    AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id             String   @id @default(uuid())
  assignmentId   String
  studentId      String
  attachments    Json?    // Optional JSON containing array of { url: string, filename: string }
  notes          String?
  status         SubmissionStatus @default(SUBMITTED)
  grade          Float?
  feedback       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment     Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum TrackType {
  TUITION
  ENTRANCE
  BOTH
}

// -----------------------------------------------------------------------------
// PROGRESS TRACKING
// -----------------------------------------------------------------------------

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model BatchChapterProgress {
  id          String   @id @default(uuid())
  batchId     String
  chapterId   String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([batchId, chapterId])
  @@map("batch_chapter_progress")
}

model BatchTopicProgress {
  id          String   @id @default(uuid())
  batchId     String
  topicId     String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([batchId, topicId])
  @@map("batch_topic_progress")
}

